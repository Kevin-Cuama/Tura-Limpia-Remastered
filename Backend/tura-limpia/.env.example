# Copie este archivo como .env y complete los valores.
# El archivo .env NO se sube a GitHub (está en .gitignore).

# Puerto en el que escucha el backend
PORT=3000

# Direcciones del frontend que pueden llamar a la API, separadas por coma.
# Si se deja vacío se acepta cualquier dirección (útil en desarrollo).
# En producción ponga la URL pública del frontend, por ejemplo:
# CORS_ORIGENES=https://tura-limpia.vercel.app
CORS_ORIGENES=

# Conexión con PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=cambie_esta_contrasena
DB_NAME=tura_limpia

# Firma de los tokens de sesión (use un texto largo y aleatorio)
# Puede generarlo con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=cambie_este_secreto
JWT_EXPIRES_IN=8h

# Costo del hash de contraseñas (bcrypt)
BCRYPT_SALTOS=10

# Administrador inicial que crea `npm run seed`
ADMIN_NOMBRE=Administrador
ADMIN_CORREO=admin@turalimpia.com
ADMIN_CONTRASENA=cambie_esta_contrasena
